# Rhabdomyolysis Aki Agent - Environment Configuration
# Copy this file to .env and fill in your values

# HMAC-SHA256 Audit Trail Secret Key (required)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# Supported provider: deterministic demonstration only
MODEL_PROVIDER=mock

# Optional separate credential for GET /api/audit/logs (required to enable it)
# Use a different value from AUDIT_SECRET_KEY
AUDIT_READ_TOKEN=
