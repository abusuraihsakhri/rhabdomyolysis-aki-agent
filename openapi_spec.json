{
  "openapi": "3.1.0",
  "info": {
    "title": "Rhabdomyolysis AKI demonstration API",
    "description": "Generic illustrative rule checks only; not a validated McMahon, KDIGO or clinical scoring implementation.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service responds to health checks"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return in-memory JSON operational counters",
        "responses": {
          "200": {
            "description": "JSON count fields"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate illustrative unitless software rules",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic demonstration dossier with signed audit-record hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return deterministic mock demonstration text (not clinical advice)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit trail with independent audit-read token",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Missing or invalid audit-read token"
          }
        },
        "security": [
          {
            "AuditReadToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuditReadToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Audit-Key",
        "description": "Separate AUDIT_READ_TOKEN. Log-read endpoint disabled if unset."
      }
    }
  }
}
